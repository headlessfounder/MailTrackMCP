{
  "name": "mailtrackmcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,

  // OPTIONAL — email powers magic-link sign-in and engagement alerts.
  // Tracking works fine without it. To enable:
  //   1. npx wrangler email sending enable yourdomain.com
  //   2. uncomment the line below and set NOTIFY_FROM to an address on that domain
  //   3. npx wrangler deploy
  // (Prefer Resend? Skip this and set a RESEND_API_KEY secret instead.)
  // "send_email": [{ "name": "EMAIL" }],

  "vars": {
    // Host that tracking pixels and links are served from. Leave empty to use
    // the Worker's own origin; set a subdomain of your SENDING domain (e.g.
    // go.yourdomain.com) so links match the From address — spam filters care.
    "TRACKING_HOST": "",
    // Sender for sign-in links and alerts. Must be on an email-enabled domain.
    "NOTIFY_FROM": "MailTrackMCP <notify@yourdomain.com>",
    // Seconds after send during which a proxied open counts as the sender
    // re-reading their own copy rather than a real recipient open.
    "SELF_OPEN_WINDOW_SEC": "90"
    // Receiver requires an Authorization header? Store the value with
    //   npx wrangler secret put WEBHOOK_AUTH
    // and set the hostname it belongs to here, so the credential is never
    // sent to any other webhook URL:
    // ,"WEBHOOK_AUTH_SCHEME": "Bearer"
    // ,"WEBHOOK_AUTH_HOST": "api.your-receiver.com"
  },

  // To serve tracking from a custom domain, uncomment and set your subdomain.
  // It must be a zone in the same Cloudflare account.
  // "routes": [{ "pattern": "go.yourdomain.com", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailtrackmcp",
      // One-click deploy fills this in for you. Deploying by CLI? Replace it
      // with the id printed by:  npx wrangler d1 create mailtrackmcp
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
